/* ===== MAGI Miniprogram Styles ===== */
page {
  background: #000;
  color: #ffae00;
  font-family: 'Share Tech Mono', 'Noto Sans SC', monospace;
}

.container {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 30rpx 40rpx;
  box-sizing: border-box;
  opacity: 0;
  transition: opacity 0.8s ease;
}
.container.booted {
  opacity: 1;
}

/* CRT effects */
.scanlines {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: repeating-linear-gradient(
    0deg, transparent 0px, transparent 2px, rgba(255, 174, 0, 0.025) 2px, transparent 3px
  );
  pointer-events: none; z-index: 100;
  animation: scanlineMove 0.2s linear infinite;
}
@keyframes scanlineMove {
  0% { background-position: 0 0; }
  100% { background-position: 0 4px; }
}

.crt-flicker {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: radial-gradient(ellipse at center, transparent 0%, rgba(0,0,0,0.08) 100%);
  pointer-events: none; z-index: 99;
  opacity: 0.06;
  animation: flicker 0.15s infinite;
}
@keyframes flicker {
  0%, 100% { opacity: 0.05; }
  50% { opacity: 0.09; }
}

/* Top labels */
.top-bar {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 24rpx;
  position: relative; z-index: 10;
}
.top-label {
  font-family: 'Noto Serif JP', serif;
  font-size: 72rpx;
  font-weight: 900;
  color: #ffae00;
  letter-spacing: 8rpx;
  text-shadow: 0 0 16rpx rgba(255, 174, 0, 0.4);
  line-height: 1;
}
.top-label.deco::before, .top-label.deco::after {
  content: ''; display: block; height: 3rpx; background: #ffae00;
  box-shadow: 0 0 8rpx rgba(255, 174, 0, 0.5);
  margin: 8rpx 0;
}

/* Left metadata panel */
.left-panel {
  border: 2rpx solid #ffae00;
  padding: 24rpx 22rpx;
  background: rgba(0,0,0,0.9);
  position: relative; z-index: 10;
  margin-bottom: 24rpx;
}
.left-panel::before {
  content: ''; position: absolute; top: -2rpx; left: -2rpx; right: -2rpx; height: 3rpx;
  background: #ffae00; box-shadow: 0 0 10rpx #ffae00;
}

.meta-list { margin-bottom: 24rpx; }
.meta-row {
  display: flex; justify-content: flex-start; align-items: baseline; gap: 10rpx;
  margin-bottom: 8rpx; font-size: 24rpx; letter-spacing: 1rpx;
}
.meta-label { color: #b87a00; font-size: 22rpx; min-width: 140rpx; }
.meta-value { color: #ffae00; font-weight: 700; }
.meta-code { font-size: 40rpx; letter-spacing: 2rpx; }
.on { color: #4fffd4; text-shadow: 0 0 8rpx #4fffd4; }

.input-area { border-top: 1rpx solid #b87a00; padding-top: 20rpx; }
.input-label {
  font-size: 20rpx; color: #b87a00; letter-spacing: 3rpx; margin-bottom: 10rpx;
}
.question-input {
  width: 100%; height: 70rpx; background: #0a0a0a;
  border: 1rpx solid #b87a00; color: #ffae00;
  padding: 0 20rpx; font-size: 26rpx; margin-bottom: 16rpx;
  box-sizing: border-box; outline: none;
  font-family: 'Noto Sans SC', 'Share Tech Mono', monospace;
}

.button-row { display: flex; gap: 16rpx; }
.btn {
  flex: 1; background: transparent; border: 1rpx solid #ffae00; color: #ffae00;
  padding: 18rpx 0; font-size: 24rpx; letter-spacing: 2rpx;
  font-family: 'Share Tech Mono', monospace; font-weight: 700;
  line-height: 1;
}
.btn::after { border: none; }
.btn[disabled] { opacity: 0.4; }

/* Center area */
.center-area {
  position: relative;
  width: 600rpx; height: 600rpx;
  margin: 0 auto 30rpx;
  z-index: 5;
}

.magi-title {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  font-family: 'Share Tech Mono', monospace;
  font-size: 72rpx; font-weight: 900;
  color: #ffae00; letter-spacing: 10rpx;
  text-shadow: 0 0 30rpx rgba(255, 174, 0, 0.5);
  animation: titleFlicker 4s infinite;
  z-index: 2;
}
@keyframes titleFlicker {
  0%, 100% { opacity: 1; }
  5% { opacity: 0.7; }
  10% { opacity: 1; }
  15% { opacity: 0.85; }
  20% { opacity: 1; }
  92% { opacity: 1; }
  94% { opacity: 0.6; }
  96% { opacity: 1; }
}

.ring {
  position: absolute; left: 50%; top: 50%;
  width: 76%; height: 76%;
  transform: translate(-50%, -50%);
  border: 2rpx solid rgba(255, 174, 0, 0.35);
  border-radius: 50%;
  z-index: 0;
  box-shadow: 0 0 20rpx rgba(255, 174, 0, 0.1);
}

/* Connection lines from center to each panel */
.line {
  position: absolute; top: 50%; left: 50%;
  width: 220rpx; height: 2rpx; background: rgba(255, 174, 0, 0.35);
  transform-origin: left center; z-index: 0;
  box-shadow: 0 0 6rpx rgba(255, 174, 0, 0.2);
}
.line1 { transform: translateY(-50%) rotate(-90deg); }
.line2 { transform: translateY(-50%) rotate(30deg); }
.line3 { transform: translateY(-50%) rotate(150deg); }

/* Panels */
.panel {
  position: absolute; border: 3rpx solid #ffae00;
  display: flex; align-items: center; justify-content: center;
  z-index: 3; box-shadow: 0 0 20rpx rgba(255, 174, 0, 0.15);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
.panel.balthasar {
  width: 170rpx; height: 200rpx;
  left: 50%; top: 0;
  transform: translateX(-50%);
  background: #4fffd4;
}
.panel.melchior {
  width: 170rpx; height: 200rpx;
  right: 30rpx; bottom: 30rpx;
  background: #4fffd4;
}
.panel.caspar {
  width: 170rpx; height: 200rpx;
  left: 30rpx; bottom: 30rpx;
  background: #e31b23;
}

.panel-inner {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center;
}
.panel-jp {
  font-family: 'Noto Serif JP', serif;
  font-size: 48rpx; font-weight: 900;
  color: #000; margin-bottom: 6rpx;
  letter-spacing: 2rpx;
}
.panel-en {
  font-family: 'Share Tech Mono', monospace;
  font-size: 18rpx; color: #000;
  letter-spacing: 1rpx; font-weight: 700;
}

.panel.analyzing { animation: panelPulse 0.8s ease-in-out infinite; }
@keyframes panelPulse {
  0%, 100% { box-shadow: 0 0 20rpx rgba(255, 174, 0, 0.15); }
  50% { box-shadow: 0 0 35rpx rgba(255, 174, 0, 0.7); }
}

/* Right decision panel */
.right-panel {
  display: flex; align-items: center; gap: 20rpx;
  margin-bottom: 24rpx; z-index: 10;
}
.right-label {
  font-family: 'Noto Serif JP', serif;
  font-size: 48rpx; font-weight: 900;
  color: #ffae00; letter-spacing: 4rpx;
  text-shadow: 0 0 15rpx rgba(255, 174, 0, 0.3);
}
.decision-box {
  width: 120rpx; height: 120rpx;
  border: 3rpx solid #ffae00;
  display: flex; align-items: center; justify-content: center;
  background: #111;
  transition: all 0.5s;
  box-shadow: 0 0 15rpx rgba(255, 174, 0, 0.1);
}
.decision-box.approve { background: #4fffd4; box-shadow: 0 0 25rpx rgba(79, 255, 212, 0.4); }
.decision-box.deny { background: #e31b23; box-shadow: 0 0 25rpx rgba(227, 27, 35, 0.4); }
.decision-box.abstain { background: #ffae00; box-shadow: 0 0 25rpx rgba(255, 174, 0, 0.4); }
.decision-jp {
  font-family: 'Noto Serif JP', serif;
  font-size: 44rpx; font-weight: 900;
  color: #000; letter-spacing: 2rpx;
}
.decision-box.reveal { animation: decisionFlash 0.7s ease; }
@keyframes decisionFlash {
  0% { transform: scale(0.7); opacity: 0; }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}

/* Analysis log */
.analysis-log {
  background: rgba(0,0,0,0.95);
  border-top: 2rpx solid #ffae00;
  padding: 16rpx 0; z-index: 50;
}
.log-header {
  font-size: 22rpx; color: #b87a00;
  letter-spacing: 4rpx; margin-bottom: 12rpx;
  font-family: 'Share Tech Mono', monospace;
}
.log-body { display: flex; flex-direction: column; gap: 16rpx; }
.log-col {
  border: 1rpx solid #b87a00;
  padding: 16rpx 18rpx; font-size: 24rpx;
  line-height: 1.7; min-height: 120rpx;
  background: rgba(10, 10, 10, 0.6);
  font-family: 'Noto Sans SC', monospace;
}
.log-col.cyan { border-color: #4fffd4; color: #4fffd4; }
.log-col.red { border-color: #e31b23; color: #e31b23; }
.log-title {
  font-family: 'Share Tech Mono', monospace;
  font-size: 22rpx; letter-spacing: 1rpx;
  display: block; margin-bottom: 8rpx; font-weight: 700;
}
.log-text { word-break: break-all; }
.cursor { color: currentColor; animation: cursorBlink 0.8s steps(2) infinite; }
@keyframes cursorBlink { 50% { opacity: 0; } }
.log-empty { color: #b87a00; text-align: center; font-size: 22rpx; letter-spacing: 2rpx; padding: 40rpx 0; }

/* Responsive for larger screens (tablets) */
@media (min-width: 768px) {
  .top-label { font-size: 96rpx; }
  .center-area { width: 700rpx; height: 700rpx; }
  .panel.balthasar { width: 200rpx; height: 240rpx; }
  .panel.melchior, .panel.caspar { width: 200rpx; height: 240rpx; }
  .panel-jp { font-size: 60rpx; }
  .magi-title { font-size: 90rpx; }
  .log-body { flex-direction: row; }
  .log-col { flex: 1; }
}

/* Small phone adjustments */
@media (max-width: 374px) {
  .center-area { width: 540rpx; height: 540rpx; }
  .panel.balthasar { width: 150rpx; height: 180rpx; }
  .panel.melchior, .panel.caspar { width: 150rpx; height: 180rpx; }
  .panel-jp { font-size: 40rpx; }
  .magi-title { font-size: 60rpx; letter-spacing: 6rpx; }
}
